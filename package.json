{
  "name": "arenafit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w apps/mobile",
    "admin": "npm run dev -w apps/admin",
    "hikaya": "npm run dev -w apps/storybook",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:test": "scripts/db/test.sh",
    "local-stack": "scripts/local-stack/up.sh",
    "presentation:prepare": "python3 scripts/presentation/prepare.py",
    "presentation:apply": "node scripts/presentation/images.mjs apply",
    "presentation:remove": "node scripts/presentation/images.mjs remove",
    "staging": "node scripts/staging/staging.mjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  }
}
