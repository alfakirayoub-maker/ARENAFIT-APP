# Copy to .env.local (git-ignored). Only public values: these end up in the app bundle.

# --- Guest invitations -------------------------------------------------------
# Branch (deferred deep linking). Use the LIVE public key (key_live_…) for
# release builds; test keys (key_test_…) only in development builds.
EXPO_PUBLIC_BRANCH_KEY=
# Branch link domains from the Branch dashboard (e.g. arenafit.app.link and
# arenafit-alternate.app.link, or a custom domain). No production domain is
# hardcoded in the app.
EXPO_PUBLIC_BRANCH_DOMAIN=
EXPO_PUBLIC_BRANCH_ALTERNATE_DOMAIN=
# Without Branch: public web base for invitation links (${base}/invite/<token>),
# e.g. a staging web build. Empty → arenafit://invite/<token> (dev only).
EXPO_PUBLIC_INVITE_BASE_URL=

# --- Supabase ----------------------------------------------------------------
# The anon key is public by design; RLS and server functions protect data.
# NEVER put the service-role key in any EXPO_PUBLIC_* variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Development builds only (never set for preview/production builds) -------
# "fixtures" uses mock content even when Supabase is configured.
EXPO_PUBLIC_DATA_SOURCE=
# Local test member for Profil › Développement › Membre test (local Supabase only).
EXPO_PUBLIC_DEV_MEMBER_EMAIL=
EXPO_PUBLIC_DEV_MEMBER_PASSWORD=
# Reception QR payloads for the dev scan simulator (written by scripts/local-stack/up.sh).
EXPO_PUBLIC_DEV_RECEPTION_QR=
EXPO_PUBLIC_DEV_RECEPTION_QR_INACTIVE=
