# Copy to .env.local (git-ignored). Only public values: these end up in the app bundle.

# Shareable link base for guest invitations (Branch link domain later).
# Leave empty until the final Arena Fit domain is chosen.
EXPO_PUBLIC_INVITE_BASE_URL=

# Branch public key for deferred deep linking (Guest Pass sprint).
EXPO_PUBLIC_BRANCH_KEY=

# Supabase (Sprint 3). The anon key is public by design; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
