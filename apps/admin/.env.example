# Copy to .env.local (git-ignored). Public values only: they reach the browser.
# The dashboard uses the anon key + the staff member's own session; every
# permission is enforced by the database (RLS + role-checked functions).
# NEVER put the service-role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
